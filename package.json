{
  "name": "dsh-plugin-kqhub",
  "version": "0.1.0",
  "description": "卡丘HUB 官方 DSH 插件，支持卡拉彼丘公开战绩查询与浏览器 OAuth 授权。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": { "kqhub-auth": "lib/auth.js" },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "auth": "node lib/auth.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kqhub-win/dsh-plugin-kqhub.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "calabiyau",
    "kqhub"
  ],
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "mcp-remote": "0.16.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "yaml": "^2.8.1"
  }
}
